#version 310 es

precision highp float;
precision highp int;
precision highp image3D;
precision highp sampler2D;
precision highp sampler3D;
precision highp sampler2DArrayShadow;
precision highp samplerCubeShadow;

#include <common.glsl>

// ------------------------------------------------------------------
// DEFINES ----------------------------------------------------------
// ------------------------------------------------------------------

#define LOCAL_SIZE_X 8
#define LOCAL_SIZE_Y 8
#define LOCAL_SIZE_Z 1
#define M_PI 3.14159265359f
#define EPSILON 0.0001f

// ------------------------------------------------------------------
// INPUTS -----------------------------------------------------------
// ------------------------------------------------------------------

layout(local_size_x = LOCAL_SIZE_X, local_size_y = LOCAL_SIZE_Y, local_size_z = LOCAL_SIZE_Z) in;

// ------------------------------------------------------------------
// OUTPUT -----------------------------------------------------------
// ------------------------------------------------------------------

layout(binding = 0, rgba16f) uniform writeonly image3D i_VoxelGrid;

// ------------------------------------------------------------------
// UNIFORMS ---------------------------------------------------------
// ------------------------------------------------------------------

layout(std140, binding = 0) uniform VolumetricUBO
{
    mat4  view;
    mat4  projection;
    mat4  view_proj;
    mat4  prev_view_proj;
    mat4  inv_view_proj;
    mat4  cascade_view_proj[3];  // Array of cascade matrices
    mat4  spot_view_proj[4];
    vec4  cascade_splits;
    vec4  cascade_biases;
    vec4  light_direction;
    vec4  light_color;
    vec4  camera_position;
    vec4  bias_near_far_pow;
    vec4  aniso_density_scattering_absorption;
    vec4  time;
    ivec4 width_height;
};

struct PointLightData {
    vec4 position_radius;
    vec4 color_intensity;
    vec4 attenuation_type;     // .w is TYPE
    vec4 direction_shadow;     // .xyz is Dir, .w is ShadowIndex
    vec4 spot_cutoffs;         // .x=inner, .y=outer
};

layout(std430, binding = 1) readonly buffer PointLightBuffer {
    PointLightData lights[];
} pointLightBuffer;


uniform sampler2DArrayShadow s_CascadeShadowMaps;
uniform sampler2DArrayShadow s_SpotShadowMaps;
uniform sampler2D s_BlueNoise;
uniform sampler3D s_History;

uniform bool u_Accumulation;

uniform int u_NumPointLights;
uniform samplerCubeShadow s_PointShadowCubemaps[4]; 
// ------------------------------------------------------------------
// FUNCTIONS --------------------------------------------------------
// ------------------------------------------------------------------

float getPointLightVisibility(vec3 worldPos, vec3 lightPos, float farPlane, int shadowIndex) {
    vec3 lightToFrag = worldPos - lightPos;
    float currentDepth = length(lightToFrag) / farPlane;
    float bias = 0.005;
    vec4 coords = vec4(lightToFrag, currentDepth - bias);
    
    float shadow = 1.0;
    
    // Manual switch for sampler arrays (GLSL best practice for broad compatibility)
    switch (shadowIndex) {
        case 0: shadow = texture(s_PointShadowCubemaps[0], coords); break;
        case 1: shadow = texture(s_PointShadowCubemaps[1], coords); break;
        case 2: shadow = texture(s_PointShadowCubemaps[2], coords); break;
        case 3: shadow = texture(s_PointShadowCubemaps[3], coords); break;
        default: shadow = 1.0; break;
    }

    return shadow;
}

float getSpotLightVisibility(vec3 worldPos, int shadowIndex) {
    // 1. Get Matrix from UBO
    mat4 lightMatrix = spot_view_proj[shadowIndex]; // Make sure this array exists in UBO struct!

    // 2. Project
    vec4 lightSpacePos = lightMatrix * vec4(worldPos, 1.0);
    vec3 projCoords = lightSpacePos.xyz / lightSpacePos.w;
    projCoords = projCoords * 0.5 + 0.5; // [-1,1] -> [0,1]

    // 3. Bounds Check
    if(projCoords.z > 1.0 || projCoords.x < 0.0 || projCoords.x > 1.0 || projCoords.y < 0.0 || projCoords.y > 1.0)
        return 1.0;

    // 4. Sample
    float bias = 0.0005; 
    return texture(s_SpotShadowMaps, vec4(projCoords.xy, float(shadowIndex), projCoords.z - bias));
}

// ------------------------------------------------------------------

float visibility(vec3 p)
{
    // Get view space depth for cascade selection
    vec4 view_pos = view * vec4(p, 1.0);
    float depth = abs(view_pos.z);
    
    // Select cascade
    int cascade = 2;
    if (depth < cascade_splits.x) cascade = 0;
    else if (depth < cascade_splits.y) cascade = 1;
    
    // Use the appropriate cascade matrix
    vec4 light_space_pos = cascade_view_proj[cascade] * vec4(p, 1.0);
    vec3 proj_coords = light_space_pos.xyz / light_space_pos.w;
    proj_coords = proj_coords * 0.5 + 0.5;
    
    if (any(greaterThan(proj_coords.xy, vec2(1.0f))) || any(lessThan(proj_coords.xy, vec2(0.0f))))
        return 1.0f;

    float bias = cascade_biases[cascade];
    return texture(s_CascadeShadowMaps, vec4(proj_coords.xy, float(cascade), proj_coords.z - bias));
}

// ------------------------------------------------------------------

// Henyey-Greenstein
float phase_function(vec3 Wo, vec3 Wi, float g)
{
    float cos_theta = dot(Wo, Wi);
    float denom     = 1.0f + g * g + 2.0f * g * cos_theta;
    return (1.0f / (4.0f * M_PI)) * (1.0f - g * g) / max(pow(denom, 1.5f), EPSILON);
}

// ------------------------------------------------------------------

float z_slice_thickness(int z)
{
    //return 1.0f; //linear depth
    return exp(-float(VOXEL_GRID_SIZE_Z - z - 1) / float(VOXEL_GRID_SIZE_Z));
}

// ------------------------------------------------------------------

float sample_blue_noise(ivec3 coord)
{
    ivec2 noise_coord = (coord.xy + ivec2(0, 1) * coord.z * BLUE_NOISE_TEXTURE_SIZE) % BLUE_NOISE_TEXTURE_SIZE;
    return texelFetch(s_BlueNoise, noise_coord, 0).r;
}

// ------------------------------------------------------------------
// MAIN -------------------------------------------------------------
// ------------------------------------------------------------------

void main()
{
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);

    if (all(lessThan(coord, ivec3(VOXEL_GRID_SIZE_X, VOXEL_GRID_SIZE_Y, VOXEL_GRID_SIZE_Z))))
    {
        // Get jitter for the current pixel, remapped to -0.5 to +0.5 range.
        float jitter = (sample_blue_noise(coord) - 0.5f) * 0.999f;

        // Get the world position of the current voxel.
        vec3 world_pos = id_to_world_with_jitter(coord, jitter, bias_near_far_pow.y, bias_near_far_pow.z, bias_near_far_pow.w, inv_view_proj);

        // Get the view direction from the current voxel.
        vec3 Wo = normalize(camera_position.xyz - world_pos);

        // Density and coefficient estimation.
        float thickness  = z_slice_thickness(coord.z);
        float density    = aniso_density_scattering_absorption.y;
        
        // Perform lighting.
        vec3 lighting = vec3(0.0);

        float visibility_value = visibility(world_pos);

        if (visibility_value > EPSILON)
            lighting += visibility_value * light_color.xyz * phase_function(Wo, -light_direction.xyz, aniso_density_scattering_absorption.x);

        for (int i = 0; i < u_NumPointLights; i++) {
            PointLightData light = pointLightBuffer.lights[i];
            vec3 lightVec = light.position_radius.xyz - world_pos;
            float distance = length(lightVec);

            // Check Radius
            if (distance < light.position_radius.w) {
                vec3 Wi = normalize(lightVec);
                float spotIntensity = 1.0;
                bool isSpotLight = (light.attenuation_type.w > 1.5);

                // 1. Calculate Spotlight Cone Intensity
                if (isSpotLight) { 
                    float theta = dot(normalize(-Wi), normalize(light.direction_shadow.xyz));
                    float epsilon = light.spot_cutoffs.x - light.spot_cutoffs.y;
                    spotIntensity = clamp((theta - light.spot_cutoffs.y) / epsilon, 0.0, 1.0);
                }

                // 2. Calculate Attenuation
                float attenuation = 1.0 / (light.attenuation_type.x + 
                                        light.attenuation_type.y * distance + 
                                        light.attenuation_type.z * distance * distance);

                // 3. Shadow Logic (Branching)
                float shadowVisibility = 1.0;
                
                // Only calculate if shadow index is valid (>= 0)
                if (light.direction_shadow.w >= 0.0) { 
                    int shadowIdx = int(round(light.direction_shadow.w));

                    if (isSpotLight) {
                        // == SPOTLIGHT ==
                        // 1. Cone Falloff
                        float theta = dot(normalize(-Wi), normalize(light.direction_shadow.xyz));
                        float epsilon = light.spot_cutoffs.x - light.spot_cutoffs.y;
                        spotIntensity = clamp((theta - light.spot_cutoffs.y) / epsilon, 0.0, 1.0);

                        // 2. Shadow Map Sample (NEW)
                        shadowVisibility = getSpotLightVisibility(world_pos, shadowIdx);

                    } else {
                        // OLD: Sample Cubemap
                        shadowVisibility = getPointLightVisibility(world_pos, light.position_radius.xyz, light.position_radius.w, shadowIdx);
                    }
                }
                
                // 4. Final Accumulation
                if (shadowVisibility > EPSILON && spotIntensity > EPSILON) { 
                    lighting += shadowVisibility * spotIntensity * light.color_intensity.rgb * attenuation * phase_function(Wo, Wi, aniso_density_scattering_absorption.x);
                }
            }
        }

        // RGB = Amount of in-scattered light, A = Density.
        vec4 color_and_density = vec4(lighting * density, density);

        // Temporal accumulation
        if (u_Accumulation)
        { 
            vec3 world_pos_without_jitter = id_to_world(coord, bias_near_far_pow.y, bias_near_far_pow.z, bias_near_far_pow.w, inv_view_proj);                

            // Find the history UV
            vec3 history_uv = world_to_uv(world_pos_without_jitter, bias_near_far_pow.y, bias_near_far_pow.z, bias_near_far_pow.w, prev_view_proj);

            // If history UV is outside the frustum, skip history
            if (all(greaterThanEqual(history_uv, vec3(0.0f))) && all(lessThanEqual(history_uv, vec3(1.0f))))
            {
                // Fetch history sample
                vec4 history = textureLod(s_History, history_uv, 0.0f);

                color_and_density = mix(history, color_and_density, 0.05f);
            }
        }

        // Write out lighting.
        imageStore(i_VoxelGrid, coord, color_and_density);
    }
}