#version 320 es

precision highp float;
precision highp int;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ------------------------------------------------------------------
// DATA STRUCTURES
// ------------------------------------------------------------------

struct Particle {
    vec4 position_life;
    vec4 velocity_size;
    vec4 color;
};

// ------------------------------------------------------------------
// BUFFERS
// ------------------------------------------------------------------

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

// ------------------------------------------------------------------
// UNIFORMS
// ------------------------------------------------------------------

uniform float u_DeltaTime;
uniform int u_MaxParticles;

// ------------------------------------------------------------------
// MAIN LOGIC
// ------------------------------------------------------------------

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(u_MaxParticles)) return;

    if (particles[idx].position_life.w > 0.0) {
        // Decrease life
        particles[idx].position_life.w -= u_DeltaTime;
        
        // Gravity (Pulling Y down slightly over time)
        particles[idx].velocity_size.y -= 4.0 * u_DeltaTime;
        
        // Move
        particles[idx].position_life.xyz += particles[idx].velocity_size.xyz * u_DeltaTime;
        
        // Fade out alpha smoothly as life approaches 0
        particles[idx].color.a = clamp(particles[idx].position_life.w * 2.0, 0.0, 1.0);
    }
}